        "topic": {
          "type": "string",
          "maxLength": 4096
        },
        "slowmode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21600
        },
        "nsfw": {
          "type": "boolean"
        },
        "permission_overwrites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
