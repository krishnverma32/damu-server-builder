                    "add_reactions",
                    "administrator",
                    "attach_files",
                    "ban_members",
                    "connect",
                    "create_private_threads",
                    "create_public_threads",
                    "deafen_members",
                    "embed_links",
                    "kick_members",
                    "manage_channels",
