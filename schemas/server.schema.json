            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "bitrate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 384000
        },
        "user_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "thread_slowmode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21600
        },
        "auto_archive": {
          "enum": [
            60,
            1440,
            4320,
            10080
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "pattern": "\\S"
              },
              "emoji": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "moderated": {
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "default_sort_order": {
          "enum": [
            "latest_activity",
            "creation_date"
          ]
        },
        "default_layout": {
          "enum": [
            "not_set",
            "list",
            "list_view",
            "gallery",
            "gallery_view"
          ]
        },
        "default_reaction_emoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "\\S"
              },
              "auto_archive": {
                "enum": [
                  60,
                  1440,
                  4320,
                  10080
                ]
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": [
