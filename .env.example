# ==============================================================================
# DAMU Server Builder - Environment Configuration Template
# Copy this file to .env for local development or enter values in Render Dashboard.
# NEVER commit your real tokens or secrets to version control.
# ==============================================================================

# [REQUIRED] Discord Bot Token from Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# [OPTIONAL] OpenRouter API Key for AI chat features (/ai command)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# [OPTIONAL] GIPHY API Key for dynamic welcome banner GIFs
GIPHY_API_KEY=your_giphy_api_key_here

# [OPTIONAL / RECOMMENDED FOR PRODUCTION] MongoDB Atlas Connection URI for persistent ticket configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_uri_here

# [OPTIONAL] Web Server Port (Defaults to 8080 locally; Render sets this automatically)
PORT=8080

# [OPTIONAL] Moderation and Ticket Logging Channel IDs (Discord Channel Snowflakes)
MOD_LOG_CHANNEL_ID=0
TICKET_LOG_CHANNEL_ID=0
SUPPORT_ROLE_ID=0

# [OPTIONAL] Developer and Bot Owner Discord User IDs (Comma-separated)
DEV_IDS=
SERVER_BUILD_OWNER_ID=486555340670894080
BOT_OWNER_ID=486555340670894080
SERVER_BUILD_BYPASS_IDS=
