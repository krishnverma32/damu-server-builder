# Discord bot token used to connect the bot.
DISCORD_TOKEN=your-discord-bot-token

# OpenRouter API key for AI chat and server generation.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional Giphy API key for GIF features.
GIPHY_API_KEY=your-giphy-api-key

# Optional MongoDB URI used by ticket_system and automod persistence.
MONGO_URI=mongodb+srv://user:password@cluster.example/db

# Unused YouTube OAuth token JSON; keep empty until a feature owns it.
YOUTUBE_OAUTH_TOKEN_JSON=

# Moderation log channel ID.
MOD_LOG_CHANNEL_ID=0

# Ticket log channel ID.
TICKET_LOG_CHANNEL_ID=0

# Support role ID for ticket access.
SUPPORT_ROLE_ID=0

# Comma-separated developer Discord user IDs.
DEV_IDS=123456789012345678

# Required Discord user ID that approves server builds.
SERVER_BUILD_OWNER_ID=123456789012345678

# Discord user ID that receives bot-owner-only reports and alerts.
BOT_OWNER_ID=123456789012345678

# Comma-separated user IDs allowed to bypass server build checks.
SERVER_BUILD_BYPASS_IDS=

# Per-user daily AI token limit.
AI_USER_DAILY_LIMIT=10000

# Global daily AI token limit across the bot.
AI_DAILY_TOKEN_LIMIT=100000

# SQLite database path.
DATABASE_FILE=data/bot.db
